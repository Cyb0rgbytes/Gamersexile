# Copy to .env.local for local development. Never commit real values.
#
# In production (Cloudflare Worker) set the public values as build/runtime
# variables and the secret with:
#   npx wrangler secret put CLERK_SECRET_KEY

# Clerk (dashboard.clerk.com → API keys). Without these the site runs with
# sign-in switched off.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people to sign in / up (locale is added by the site).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/sign-up

# MEE6 leaderboard: the Discord server (guild) ID. In Discord enable
# Developer Mode, right-click the server → Copy Server ID.
MEE6_GUILD_ID=
