{
  "name": "gamers-exile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/strip-build-secrets.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gamersexile --local",
    "db:migrate:remote": "wrangler d1 migrations apply gamersexile --remote",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.7",
    "@formatjs/intl-localematcher": "^0.10.2",
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.20.18",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.13.0",
    "lenis": "^1.3.26",
    "motion": "^13.0.0",
    "negotiator": "^1.1.0",
    "next": "^16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  },
  "overrides": {
    "@opennextjs/aws": {
      "cookie": "0.7.2"
    }
  }
}
